# Steam Web API key and SteamID64 are entered directly in the CachePanel
# Settings page after first launch — no need to set them here. These two
# vars only exist as an optional fallback for deployments that prefer
# container-level config over the UI.
# STEAM_API_KEY=
# STEAM_ID64=

# Only override these if your prefill tools live somewhere other than the
# default LanCache Docker layout (/opt/stacks/<tool>/config)
# STEAM_PREFILL_CONFIG_DIR=/opt/stacks/steam-prefill/config
# BATTLENET_PREFILL_CONFIG_DIR=/opt/stacks/battlenet-prefill/config
# EPIC_PREFILL_CONFIG_DIR=/opt/stacks/epic-prefill/config
# LANCACHE_LOG_DIR=/mnt/lancache/logs

# Container names of the running prefill tools, if different from defaults
# STEAM_PREFILL_CONTAINER=steam-prefill
# BATTLENET_PREFILL_CONTAINER=battlenet-prefill
# EPIC_PREFILL_CONTAINER=epic-prefill

# LAN IP of the machine running lancache + lancache-dns (usually this same
# host). Powers the DNS/cache-reachability diagnostics on the dashboard --
# left blank, those checks just report "not configured" instead of guessing.
# LANCACHE_IP=

# Optional: store settings/run history/schedule/panel login in PostgreSQL
# instead of the JSON files under ./data. Leave commented out for the
# default zero-config file storage. If you set this, also start the
# optional postgres service: `docker compose --profile postgres up -d`.
# Switching from files to Postgres starts with EMPTY tables -- there is no
# automatic migration, you'll re-enter settings and set up the panel login
# again. See the README's "Optional: PostgreSQL" section.
# DATABASE_URL=postgresql://cachepanel:changeme@postgres:5432/cachepanel
